# =============================================================================
# Async-Messaging-Architecture - LOCAL DEVELOPMENT settings
#
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# Then change the two passwords below. `.env` is git-ignored; never commit it.
# These values are for a laptop running Docker Desktop, NOT for production.
# =============================================================================

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=jobs_app
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=jobs
# Host port for connecting from your machine (QA tests, psql). Bound to
# 127.0.0.1 only. 5433 avoids clashing with a locally installed PostgreSQL.
POSTGRES_HOST_PORT=5433

# ---- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=jobs_app
RABBITMQ_PASSWORD=change-me-local-rabbitmq-password
RABBITMQ_VHOST=/
# Host ports (bound to 127.0.0.1). Management UI: http://localhost:15672
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Exchange / queue names. Changing them creates NEW queues; old ones remain.
RABBITMQ_EXCHANGE=reports
RABBITMQ_ROUTING_KEY=report.generate
RABBITMQ_QUEUE=reports.jobs
RABBITMQ_RETRY_EXCHANGE=reports.retry
RABBITMQ_RETRY_QUEUE=reports.jobs.retry
RABBITMQ_DLX=reports.dlx
RABBITMQ_DLQ=reports.jobs.dlq
RABBITMQ_DLQ_ROUTING_KEY=report.dead

# ---- API ---------------------------------------------------------------------
# Dashboard + REST API: http://localhost:3000
API_PORT=3000
LOG_LEVEL=info
# Lets requests include {"simulate": {...}} to demo retries/DLQ. Set false
# anywhere other than a local demo environment.
ALLOW_FAILURE_SIMULATION=true
# /api/health reports "degraded" when the oldest unpublished outbox row is older than this.
OUTBOX_DEGRADED_AFTER_MS=30000

# ---- Worker ------------------------------------------------------------------
# Unacknowledged messages per worker process (= max concurrent jobs per worker).
WORKER_PREFETCH=1
# Total processing attempts per job (first try + retries).
MAX_ATTEMPTS=3
# Delay before a failed job is retried. This is the retry queue's x-message-ttl:
# after changing it you must delete the retry queue (see README > Troubleshooting).
RETRY_DELAY_MS=3000
# Back-off before NACK+requeue when PostgreSQL/RabbitMQ itself fails.
INFRA_RETRY_BACKOFF_MS=2000
# Processing lease. Extended at every progress update; if a worker dies, another
# worker may take the job over once the lease has expired.
JOB_LEASE_MS=10000
# Simulated report generation time (random between min and max).
PROCESSING_MIN_MS=3000
PROCESSING_MAX_MS=5000
# How long a stopping worker waits for in-flight jobs before closing.
WORKER_SHUTDOWN_TIMEOUT_MS=15000

# ---- Outbox publisher --------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
# Safety net: re-enqueue jobs stuck in queued/processing longer than this.
RECONCILE_INTERVAL_MS=60000
RECONCILE_STALE_MS=600000

# ---- QA suite (tests/) -------------------------------------------------------
# p95 latency budget asserted by TEST 1 for POST /api/jobs.
QA_LATENCY_BUDGET_MS=100
