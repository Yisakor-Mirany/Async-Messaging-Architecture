    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  }
