{
  "name": "async-messaging-qa",
  "version": "1.0.0",
  "description": "End-to-end QA suite. Runs against the live Docker Compose stack.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest --runInBand",
    "test:01": "jest --runInBand integration/01",
    "test:02": "jest --runInBand integration/02",
    "test:03": "jest --runInBand integration/03",
    "test:04": "jest --runInBand integration/04",
    "test:05": "jest --runInBand integration/05",
    "test:06": "jest --runInBand integration/06",
    "test:07": "jest --runInBand integration/07"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/integration/**/*.test.js"
    ],
    "testTimeout": 240000,
    "verbose": true,
    "testSequencer": "<rootDir>/sequencer.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "amqplib": "^0.10.9",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "pg": "^8.23.1"
  }
}
